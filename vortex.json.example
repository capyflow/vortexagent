{
  "provider": {
    "name": "openai",
    "apiKeyEnv": "OPENAI_API_KEY",
    "baseURL": "",
    "model": "deepseek-chat",
    "maxTokens": 0,
    "temperature": null,
    "thinking": false
  },
  "knowledge": [
    "./docs"
  ],
  "mcpServers": [
    {
      "name": "example-tools",
      "command": "go",
      "args": ["run", "./examples/mcp-server"],
      "env": {}
    }
  ],
  "systemPrompt": "",
  "tools": {
    "exec": {
      "enabled": false,
      "workdir": "."
    },
    "filesystem": {
      "enabled": false,
      "root": "."
    },
    "memory": {
      "enabled": false,
      "dir": ""
    }
  },
  "permissions": {
    "mode": "confirm",
    "allow": [
      "read_file",
      "list_files",
      "exec_command:git status*",
      "mcp__example-tools"
    ],
    "deny": [
      "exec_command:rm -rf*",
      "exec_command:mkfs*"
    ]
  },
  "session": {
    "type": "json",
    "file": ""
  }
}
