{
  "provider": {
    "name": "openai",
    "apiKeyEnv": "OPENAI_API_KEY",
    "baseURL": "",
    "model": "deepseek-chat",
    "maxTokens": 0,
    "temperature": null,
    "thinking": false
  },
  "knowledge": [
    "./docs"
  ],
  "mcpServers": [
    {
      "name": "example-tools",
      "command": "go",
      "args": [
        "run",
        "./examples/mcp-server"
      ],
      "env": {}
    }
  ],
  "systemPrompt": "",
  "tools": {
    "exec": {
      "enabled": false,
      "workdir": ".",
      "maxOutput": 8000
    },
    "filesystem": {
      "enabled": false,
      "root": ".",
      "maxContent": 8000
    },
    "memory": {
      "enabled": false,
      "dir": ""
    }
  },
  "permissions": {
    "mode": "confirm",
    "allow": [
      "read_file",
      "list_files",
      "exec_command:git status*",
      "mcp__example-tools"
    ],
    "deny": [
      "exec_command:rm -rf*",
      "exec_command:mkfs*"
    ]
  },
  "session": {
    "type": "json",
    "file": ""
  },
  "context": {
    "enabled": true,
    "softRatio": 0.7,
    "hardRatio": 0.95,
    "keepRecentBlocks": 12,
    "summaryBudget": 0.1,
    "archive": {
      "backend": "fs",
      "dir": ""
    },
    "retrieval": {
      "limit": 5
    },
    "retentionDays": 0
  }
}
