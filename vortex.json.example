{
  "provider": {
    "name": "openai",
    "apiKeyEnv": "OPENAI_API_KEY",
    "baseURL": "",
    "model": "deepseek-chat",
    "maxTokens": 0,
    "temperature": null,
    "thinking": false
  },
  "knowledge": [
    "./docs"
  ],
  "mcpServers": [
    {
      "name": "example-tools",
      "command": "go",
      "args": ["run", "./examples/mcp-server"],
      "env": {}
    }
  ],
  "systemPrompt": "",
  "tools": {
    "exec": {
      "enabled": false,
      "workdir": "."
    },
    "filesystem": {
      "enabled": false,
      "root": "."
    },
    "memory": {
      "enabled": false,
      "dir": "~/.vortex/memory"
    }
  },
  "session": {
    "type": "json",
    "file": "~/.vortex/sessions.json"
  }
}
